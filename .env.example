# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Secret used to sign JWTs. Use a long, random value in every environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Comma-separated list not yet supported - single origin or "*" for now.
CORS_ORIGIN=*

# MySQL connection string (used by Prisma).
# Leave unset to run against the in-memory repositories instead - useful
# for quick local development without a database. Once set, the
# composition root automatically switches to the MySQL-backed
# repositories (see src/composition/container.ts).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://brace:brace@localhost:3306/brace_platform

# SMTP (used by the newsletter feature to actually deliver email).
# Leave SMTP_HOST unset to use the console transport instead: emails are
# logged (via requestLogger's same Logger) rather than sent, so you can
# test create -> subscribe -> send end-to-end without a mail account.
# A free option for testing real delivery is https://ethereal.email or
# https://mailtrap.io - both give you throwaway SMTP credentials.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM="BRACE Digital Platform <no-reply@brace-initiative.org>"
