// ------------------------------------------------------------------
// BRACE Digital Platform - Prisma schema
//
// Mirrors the domain shapes already used across the codebase
// (src/types/user.types.ts, partner.types.ts, training.types.ts).
// Enum members intentionally use SCREAMING_CASE (Prisma convention);
// the repository layer (src/repositories/Prisma*Repository.ts) maps
// between these and the application's own lowercase domain enums, so
// no other part of the codebase needs to know MySQL is involved.
// ------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  // "native" covers whatever platform you run `npx prisma generate` on
  // locally. The second target is required because the container is
  // node:20-alpine (musl libc, OpenSSL 3.x) - Prisma's own detection of
  // this inside Alpine is unreliable, so we pin it instead of hoping it
  // guesses right.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  WEB_MANAGER
  TECHNICAL_REVIEWER
  COUNTRY_COORDINATOR
  CONSORTIUM_PARTNER
  APPLICANT
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  fullName           String
  role               UserRole @default(APPLICANT)
  countryAffiliation String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("users")
}

model Partner {
  id            String  @id
  name          String
  country       String
  about         String  @db.MediumText
  aboutFr       String? @db.MediumText
  description   String  @db.MediumText
  descriptionFr String? @db.MediumText
  websiteUrl    String?
  logoUrl       String?
  isActive      Boolean @default(true)

  @@map("partners")
}

model TrainingApplication {
  id                String            @id @default(cuid())
  cohortId          String?
  cohort            Cohort?           @relation(fields: [cohortId], references: [id])
  applicantFullName String
  applicantEmail    String
  country           String
  organisation      String?
  motivation        String            @db.MediumText
  status            ApplicationStatus @default(SUBMITTED)
  reviewedBy        String?
  reviewNotes       String?           @db.MediumText
  submittedAt       DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([cohortId, applicantEmail])
  @@index([cohortId])
  @@index([status])
  @@index([country])
  @@map("training_applications")
}

enum TrainingStatus {
  PUBLISHED
  DISABLED
}

model Training {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.MediumText
  startDate   DateTime
  endDate     DateTime
  status      TrainingStatus @default(PUBLISHED)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cohorts     Cohort[]

  @@index([status])
  @@index([startDate])
  @@map("trainings")
}

model Cohort {
  id           String                @id @default(cuid())
  trainingId   String
  name         String
  startDate    DateTime
  endDate      DateTime
  capacity     Int
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  training     Training              @relation(fields: [trainingId], references: [id])
  applications TrainingApplication[]

  @@unique([trainingId, name])
  @@index([startDate])
  @@map("cohorts")
}

model Newsletter {
  id        String    @id @default(cuid())
  title     String
  bodyHtml  String    @db.MediumText
  createdBy String
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("newsletters")
}

model NewsletterSubscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  subscribedAt  DateTime @default(now())
  isActive      Boolean  @default(true)

  @@index([isActive])
  @@map("newsletter_subscribers")
}

enum NewsStatus {
  PUBLISHED
  DISABLED
}

model News {
  id            String     @id @default(cuid())
  title         String
  titleFr       String?
  tag           String
  tagFr         String?
  pillar        String
  pillarFr      String?
  note          String     @db.MediumText
  noteFr        String?    @db.MediumText
  body          String?    @db.MediumText
  bodyFr        String?    @db.MediumText
  imageUrl      String?
  status        NewsStatus @default(PUBLISHED)
  publishedDate DateTime
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([publishedDate])
  @@map("news")
}

enum PressReleaseStatus {
  PUBLISHED
  DISABLED
}

model PressRelease {
  id           String             @id @default(cuid())
  title        String
  titleFr      String?
  summary      String?            @db.MediumText
  summaryFr    String?            @db.MediumText
  documentUrl  String?
  documentName String?
  status       PressReleaseStatus @default(PUBLISHED)
  releaseDate  DateTime
  createdBy    String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([releaseDate])
  @@map("press_releases")
}
